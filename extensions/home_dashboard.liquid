<style>
  /* Namespace: bdFlip — 1-bit B/W Flip Clock */
  .bdflip {
    width: 300px;
  }
  .bdflip .host {
    width: 100%;
    background: var(--bd-bg, #fff);
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .bdflip svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
  }
</style>

<script>
  /* Namespace: bdFlip — themed flip clock, 4-bit auto-shading */
  (function () {
    const NS = 'http://www.w3.org/2000/svg';
    // Terminus has no TRMNL user settings, so these are fixed to the plugin defaults.
    const GLOBAL_IS_24H = true;
    const THEME_NAME = 'Classic';
    const SHOW_BORDER = true;

    const is4bit = !!document.querySelector('.screen--4bit');
    const isGray3D = THEME_NAME === 'Grayscale 3D';

    const THEMES = {
      classic: {
        tileFill: '#000',
        tileStroke: '#FFF',
        strokeW: 6,
        digitFill: '#FFF',
        digitStroke: '#000',
        digitStrokeW: 6,
        seamColor: '#FFF',
        seamW: 2,
        bgColor: '#FFF',
        shadow: null,
        shadowOffset: 0,
        seamShadow: null,
        shadow4bit: '#AAA',
        shadowOffset4bit: 2,
        seamShadow4bit: '#CCC',
        bg4bit: '#F5F5F5',
        bevelLight: null,
        bevelDark: null,
        splitFill: false,
      },
      grayscale3d: {
        tileFill: '#000',
        tileFillTop: '#1A1A1A',
        tileFillBot: '#000',
        tileStroke: '#CCC',
        strokeW: 5,
        digitFill: '#FFF',
        digitStroke: '#222',
        digitStrokeW: 6,
        seamColor: '#DDD',
        seamW: 2,
        seamShadow: '#333',
        bgColor: '#E8E8E8',
        shadow: '#888',
        shadowOffset: 3,
        bevelLight: '#555',
        bevelDark: '#111',
        splitFill: true,
      },
    };

    const themeKey = isGray3D ? 'grayscale3d' : 'classic';
    const T = THEMES[themeKey];

    const resolvedBg = themeKey === 'classic' && is4bit && T.bg4bit ? T.bg4bit : T.bgColor;
    const resolvedShadow = T.shadow || (is4bit && T.shadow4bit) || null;
    const resolvedShadowOffset = T.shadowOffset || (is4bit && T.shadowOffset4bit) || 0;
    const resolvedSeamShadow = T.seamShadow || (is4bit && T.seamShadow4bit) || null;

    const STROKE = T.strokeW;
    const DESIGN = { tileW: 120, tileH: 200, gap: 10, r: 22, font: 128 };

    function boot() {
      document.querySelectorAll('[data-bdflip="clock"]').forEach((el) => {
        if (el._bdBoot) return;
        el._bdBoot = true;
        build(el);
      });
    }

    function build(el) {
      el.innerHTML = '<div class="host"></div>';
      const host = el.querySelector('.host');
      host.style.setProperty('--bd-bg', resolvedBg);
      const svg = document.createElementNS(NS, 'svg');
      svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');
      host.appendChild(svg);
      el._svg = svg;
      render(el);
      schedule(el);

      new MutationObserver(() => render(el)).observe(el, {
        attributes: true,
        attributeFilter: ['data-12or24', 'data-ampm-scale'],
      });
    }

    function is24(el) {
      const o = (el.getAttribute('data-12or24') || '').trim();
      return o ? o === '24' : GLOBAL_IS_24H;
    }

    // Uses the renderer's local clock; Terminus has no per-user IANA zone or UTC offset.
    function timeParts(use24) {
      const d = new Date();
      let h = d.getHours(),
        m = d.getMinutes(),
        suf = null;
      if (!use24) {
        suf = h >= 12 ? ['P', 'M'] : ['A', 'M'];
        h = h % 12 || 12;
      }
      const HH = String(h).padStart(2, '0');
      const MM = String(m).padStart(2, '0');
      return { digits: [HH[0], HH[1], MM[0], MM[1]], suffix: suf };
    }

    function rect(x, y, w, h, r, fill, stroke, sw) {
      const e = document.createElementNS(NS, 'rect');
      e.setAttribute('x', x);
      e.setAttribute('y', y);
      e.setAttribute('width', w);
      e.setAttribute('height', h);
      if (r != null) e.setAttribute('rx', r);
      if (fill != null) e.setAttribute('fill', fill);
      if (stroke) {
        e.setAttribute('stroke', stroke);
        e.setAttribute('stroke-width', sw || 1);
        e.setAttribute('stroke-linejoin', 'round');
      }
      return e;
    }

    function line(x1, y1, x2, y2, stroke, sw) {
      const l = document.createElementNS(NS, 'line');
      l.setAttribute('x1', x1);
      l.setAttribute('y1', y1);
      l.setAttribute('x2', x2);
      l.setAttribute('y2', y2);
      l.setAttribute('stroke', stroke);
      l.setAttribute('stroke-width', sw || 1);
      return l;
    }

    function makeTile(x) {
      const g = document.createElementNS(NS, 'g');
      g.setAttribute('transform', `translate(${x},0)`);
      const W = DESIGN.tileW,
        H = DESIGN.tileH,
        inset = STROKE / 2;

      if (resolvedShadow) {
        const so = resolvedShadowOffset;
        g.appendChild(rect(so, so, W, H, DESIGN.r, resolvedShadow));
      }

      if (T.splitFill) {
        const clipId = 'ct' + Math.random().toString(36).slice(2, 8);
        const clipIdB = 'cb' + Math.random().toString(36).slice(2, 8);
        const defs = document.createElementNS(NS, 'defs');

        const clipTop = document.createElementNS(NS, 'clipPath');
        clipTop.setAttribute('id', clipId);
        clipTop.appendChild(rect(0, 0, W, H / 2, 0, null));
        defs.appendChild(clipTop);

        const clipBot = document.createElementNS(NS, 'clipPath');
        clipBot.setAttribute('id', clipIdB);
        clipBot.appendChild(rect(0, H / 2, W, H / 2, 0, null));
        defs.appendChild(clipBot);

        g.appendChild(defs);

        const topRect = rect(0, 0, W, H, DESIGN.r, T.tileFillTop);
        topRect.setAttribute('clip-path', `url(#${clipId})`);
        g.appendChild(topRect);

        const botRect = rect(0, 0, W, H, DESIGN.r, T.tileFillBot);
        botRect.setAttribute('clip-path', `url(#${clipIdB})`);
        g.appendChild(botRect);
      } else {
        g.appendChild(rect(0, 0, W, H, DESIGN.r, T.tileFill));
      }

      if (SHOW_BORDER) {
        g.appendChild(
          rect(inset, inset, W - STROKE, H - STROKE, Math.max(0, DESIGN.r - inset), 'none', T.tileStroke, STROKE)
        );
      }

      const t = document.createElementNS(NS, 'text');
      t.setAttribute('x', W / 2);
      t.setAttribute('y', H / 2 + DESIGN.font * 0.35);
      t.setAttribute('text-anchor', 'middle');
      t.setAttribute('font-family', 'Inter,system-ui,Arial,sans-serif');
      t.setAttribute('font-weight', '900');
      t.setAttribute('font-size', DESIGN.font);
      t.setAttribute('fill', T.digitFill);
      t.setAttribute('style', `paint-order:stroke;stroke:${T.digitStroke};stroke-width:${T.digitStrokeW};`);
      g.appendChild(t);

      const seamX1 = inset * 2,
        seamX2 = W - inset * 2;
      g.appendChild(line(seamX1, H / 2, seamX2, H / 2, T.seamColor, T.seamW));

      if (resolvedSeamShadow) {
        g.appendChild(line(seamX1, H / 2 + T.seamW, seamX2, H / 2 + T.seamW, resolvedSeamShadow, 1));
      }

      const overlay = document.createElementNS(NS, 'g');
      overlay.setAttribute('class', 'ampm');
      g.appendChild(overlay);

      return { g, text: t, overlay, w: W };
    }

    // Center horizontally, sit near the bottom of the last tile
    function drawAmPm(overlay, label, scale) {
      while (overlay.firstChild) overlay.removeChild(overlay.firstChild);

      const W = DESIGN.tileW,
        H = DESIGN.tileH;

      // size (same as before, default 0.33), and bottom inset in px (default 12)
      const s = Math.max(0.2, Math.min(1, parseFloat(scale) || 0.33));
      const inset = parseFloat(overlay.closest('[data-bdflip="clock"]').getAttribute('data-ampm-inset')) || 12;

      // place at bottom-center, with a little safety so it never touches the outline
      const g = document.createElementNS(NS, 'g');
      g.setAttribute('transform', `translate(${W / 2}, ${H - inset}) scale(${s})`);

      const t = document.createElementNS(NS, 'text');
      t.setAttribute('x', 0);
      t.setAttribute('y', 0);
      t.setAttribute('text-anchor', 'middle'); // horizontal center
      t.setAttribute('dominant-baseline', 'alphabetic'); // baseline sits on the bottom inset line
      t.setAttribute('font-family', 'Inter,system-ui,Arial,sans-serif');
      t.setAttribute('font-weight', '900');
      t.setAttribute('font-size', 90);
      t.setAttribute('letter-spacing', '0.04em');
      t.setAttribute('fill', T.digitFill);
      t.setAttribute('style', `paint-order:stroke;stroke:${T.digitStroke};stroke-width:12;`);
      t.textContent = label;

      g.appendChild(t);
      overlay.appendChild(g);
    }

    function render(el) {
      const use24 = is24(el);
      const { digits, suffix } = timeParts(use24);
      const ampmScale = parseFloat(el.getAttribute('data-ampm-scale') || '0.33');
      const n = digits.length;
      const so = resolvedShadowOffset;
      const totalW = n * DESIGN.tileW + (n - 1) * DESIGN.gap + so;
      const totalH = DESIGN.tileH + so;
      const svg = el._svg;
      svg.setAttribute('viewBox', `0 0 ${totalW} ${totalH}`);

      while (svg.firstChild) svg.removeChild(svg.firstChild);
      let x = 0;
      el._texts = [];
      const tileGroups = [];

      for (let i = 0; i < n; i++) {
        const { g, text, overlay, w } = makeTile(x);
        svg.appendChild(g);
        text.textContent = digits[i];
        el._texts.push(text);
        tileGroups.push({ g, overlay });
        x += w + (i < n - 1 ? DESIGN.gap : 0);
      }

      if (suffix) {
        const last = tileGroups[tileGroups.length - 1];
        drawAmPm(last.overlay, suffix.join(''), ampmScale);
      }
    }

    function schedule(el) {
      (function atMinute() {
        const now = new Date();
        const ms = (60 - now.getSeconds()) * 1000 - now.getMilliseconds();
        setTimeout(() => {
          const use24 = is24(el);
          const { digits, suffix } = timeParts(use24);
          for (let i = 0; i < el._texts.length; i++) {
            if (digits[i]) el._texts[i].textContent = digits[i];
          }
          const ampmScale = parseFloat(el.getAttribute('data-ampm-scale') || '0.33');
          const overlays = el._svg.querySelectorAll('g.ampm');
          overlays.forEach((o) => {
            while (o.firstChild) o.removeChild(o.firstChild);
          });
          if (suffix && overlays.length) {
            drawAmPm(overlays[overlays.length - 1], suffix.join(''), ampmScale);
          }
          atMinute();
        }, Math.max(200, ms));
      })();
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();
  })();
</script>

<div class="{{ extension.css_classes }}">
  <div class="view view--full">
    <div class="layout layout--row layout--center">
      {%- assign clock_hour = "now" | date: "%H" | plus: 0 | modulo: 12 -%}
      {%- assign clock_minute = "now" | date: "%M" | plus: 0 -%}
      {%- assign minute_half = clock_minute | divided_by: 2.0 -%}
      {%- assign hour_angle = clock_hour | times: 30 | plus: minute_half -%}
      {%- assign minute_angle = clock_minute | times: 6 -%}
      <svg width="100" height="100" viewBox="0 0 100 100">
        <path d="M3 50 A47 47 0 1 1 97 50 A47 47 0 1 1 3 50 Z" fill="none" stroke="black" stroke-width="2" />
        {%- for tick in (0..11) -%}
        <path d="M50 4 V9" stroke="black" stroke-width="1.5" transform="rotate({{ tick | times: 30 }} 50 50)" />
        {%- endfor -%}
        <g fill="black" style="font-size: 12px; font-weight: bold; text-anchor: middle">
          <text x="65.5" y="27">1</text>
          <text x="76.8" y="38.5">2</text>
          <text x="81" y="54">3</text>
          <text x="76.8" y="69.5">4</text>
          <text x="65.5" y="81">5</text>
          <text x="50" y="85">6</text>
          <text x="34.5" y="81">7</text>
          <text x="23.2" y="69.5">8</text>
          <text x="19" y="54">9</text>
          <text x="23.2" y="38.5">10</text>
          <text x="34.5" y="27">11</text>
          <text x="50" y="23">12</text>
        </g>
        <path d="M50 50 V33" stroke="black" stroke-width="3.5" stroke-linecap="round" transform="rotate({{ hour_angle }} 50 50)" />
        <path d="M50 50 V16" stroke="black" stroke-width="2" stroke-linecap="round" transform="rotate({{ minute_angle }} 50 50)" />
        <path d="M47.5 50 A2.5 2.5 0 1 1 52.5 50 A2.5 2.5 0 1 1 47.5 50 Z" fill="black" />
      </svg>

      <div class="layout layout--col layout--center stretch-x">
        {%- assign he_days = "ראשון,שני,שלישי,רביעי,חמישי,שישי,שבת" | split: "," -%}
        {%- assign he_months = "ינואר,פברואר,מרץ,אפריל,מאי,יוני,יולי,אוגוסט,ספטמבר,אוקטובר,נובמבר,דצמבר" | split: "," -%}
        {%- assign wday = "now" | date: "%w" | plus: 0 -%}
        {%- assign mon = "now" | date: "%-m" | plus: 0 | minus: 1 -%}
        <span class="label">יום {{ he_days[wday] }}, {{ "now" | date: "%-d" }} ב{{ he_months[mon] }}</span>
        <div class="bdflip" data-bdflip="clock" data-12or24="24"></div>
        <div class="title title--xlarge">משפחת קרייסלר</div>
      </div>

      <div class="progress-bar progress-bar--large">
        <div class="content">
          <span class="value value--xxsmall">{{ device.battery_percentage | round }}%</span>
        </div>
        <div class="track">
          <div class="fill" style="width: {{ device.battery_percentage | round }}%"></div>
        </div>
      </div>
    </div>

    <style>
      .screen--lg .weather-icon-mini { width: 34px; }
      .weather-icon-mini { width: 24px; }
      .screen--lg .weather-icon-forecast { width: 100px; }
      .weather-icon-forecast { width: 50px; }
    </style>
    {%- assign current = source_1.current -%}
    {%- assign daily = source_1.daily -%}
    {%- liquid
      assign is_day = current.is_day
      assign image_day = ""
      assign condition = ""

      for i in (0..5)
        if i == 0
          assign code = current.weather_code
        else
          assign code = daily.weather_code[i]
        endif

        if code == 0 or code == 1
          if is_day == 1
            assign image_day = image_day | append: "wi-day-sunny.svg,"
            assign condition = condition | append: "Sunny,"
          else
            assign image_day = image_day | append: "wi-night-clear.svg,"
            assign condition = condition | append: "Clear,"
          endif
        elsif code == 2 or code == 3
          assign condition = condition | append: "Cloudy,"
          if is_day == 1
            assign image_day = image_day | append: "wi-day-cloudy.svg,"
          else
            assign image_day = image_day | append: "wi-night-cloudy.svg,"
          endif
        elsif code == 45 or code == 48
          assign condition = condition | append: "Fog,"
          if is_day == 1
            assign image_day = image_day | append: "wi-day-fog.svg,"
          else
            assign image_day = image_day | append: "wi-night-fog.svg,"
          endif
        elsif code >= 51 and code <= 67
          assign condition = condition | append: "Rain,"
          if is_day == 1
            assign image_day = image_day | append: "wi-day-rain.svg,"
          else
            assign image_day = image_day | append: "wi-night-rain.svg,"
          endif
        elsif code >= 71 and code <= 77
          assign condition = condition | append: "Snow,"
          if is_day == 1
            assign image_day = image_day | append: "wi-day-snow.svg,"
          else
            assign image_day = image_day | append: "wi-night-snow.svg,"
          endif
        elsif code >= 80 and code <= 82
          assign condition = condition | append: "Rain,"
          if is_day == 1
            assign image_day = image_day | append: "wi-day-rain.svg,"
          else
            assign image_day = image_day | append: "wi-night-rain.svg,"
          endif
        elsif code >= 85 and code <= 86
          assign condition = condition | append: "Snow,"
          if is_day == 1
            assign image_day = image_day | append: "wi-day-snow.svg,"
          else
            assign image_day = image_day | append: "wi-night-snow.svg,"
          endif
        else
          assign condition = condition | append: "Storm,"
          if is_day == 1
            assign image_day = image_day | append: "wi-day-thunderstorm.svg,"
          else
            assign image_day = image_day | append: "wi-night-thunderstorm.svg,"
          endif
        endif
      endfor

      assign image_day = image_day | split: ","
      assign condition = condition | split: ","
    -%}
    <div class="layout">
      <div class="grid grid--cols-6 h--full">
        <div class="col col--start gap text--center">
          <span class="title">{{ extension.values.city }}</span>
          <div class="w--full">
            <img class="weather-icon-forecast" src="https://usetrmnl.com/images/plugins/weather/{{ image_day[0] }}">
            <br/>
            <span class="description text-stroke">{{ condition[0] }}</span>
          </div>
          <div class="w--full">
            <span class="value value--xsmall">{{ current.temperature_2m | round }}°</span>
          </div>
          <div class="w--full">
            <div class="flex flex--row gap--xsmall">
              <img class="weather-icon-mini" src="https://usetrmnl.com/images/plugins/weather/wi-hot.svg">
              <span class="value value--xxsmall mr--1">{{ daily.uv_index_max[0] | round }}</span>
              <img class="weather-icon-mini" src="https://usetrmnl.com/images/plugins/weather/wi-rain.svg" />
              <span class="value value--xxsmall">{{ daily.precipitation_probability_max[0] }}%</span>
            </div>
          </div>
        </div>
        {% for i in (1..5) %}
        <div class="col col--start gap text--center">
          <span class="title">{{ daily.time[i] | date: "%a" }}</span>
          <div class="w--full">
            <img class="weather-icon-forecast" src="https://usetrmnl.com/images/plugins/weather/{{ image_day[i] }}">
            <br/>
            <span class="description text-stroke">{{ condition[i] }}</span>
          </div>
          <div class="w--full">
            <span class="value value--xsmall">{{ daily.temperature_2m_min[i] | round }}° / {{ daily.temperature_2m_max[i] | round }}°</span>
          </div>
          <div class="w--full">
            <div class="flex flex--row gap--xsmall">
              <img class="weather-icon-mini" src="https://usetrmnl.com/images/plugins/weather/wi-hot.svg">
              <span class="value value--xxsmall mr--1">{{ daily.uv_index_max[i] | round }}</span>
              <img class="weather-icon-mini" src="https://usetrmnl.com/images/plugins/weather/wi-rain.svg" />
              <span class="value value--xxsmall">{{ daily.precipitation_probability_max[i] }}%</span>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
